{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scivault.org/schema/scivault-qf-package-0.1.schema.json",

  "title": "SciVault Question Format Package Manifest",
  "description": "JSON Schema for a SciVault-QF 0.1 package manifest.",

  "type": "object",

  "required": [
    "format",
    "format_version",
    "content"
  ],

  "properties": {
    "format": {
      "type": "string",
      "const": "SciVault-QF"
    },

    "format_version": {
      "type": "string",
      "const": "0.1"
    },

    "content": {
      "type": "string",
      "minLength": 1
    }
  },

  "additionalProperties": false
}
