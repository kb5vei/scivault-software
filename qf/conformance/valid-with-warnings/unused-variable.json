          "type": "integer",
          "min": 1,
          "max": 20,
          "step": 1
        }
      },

      "answer": {
        "expression": "v * t",
        "tolerance": 0.01,
        "unit": "m"
      },

      "explanation": "For constant speed, distance is $d=vt$.",

